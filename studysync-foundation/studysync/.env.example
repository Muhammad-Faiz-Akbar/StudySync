# Salin ke .env.local. JANGAN commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# anon key (atau "publishable key" di dashboard Supabase yang baru)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key. HANYA server. Jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Aplikasi
APP_TIMEZONE=Asia/Jakarta
# Domain email yang diizinkan, pisahkan dengan koma (contoh: mahasiswa.kampus.ac.id)
ALLOWED_EMAIL_DOMAINS=
# Email admin untuk halaman metrik (P1), pisahkan dengan koma
ADMIN_EMAILS=
# true = aktifkan akun demo untuk juri (hanya di lingkungan demo)
DEMO_MODE=false
